node_modules/
.expo/
dist/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.mobileprovision
apps/mobile/android/
apps/mobile/ios/
artifacts/

.tools/
migration-source.tar.gz

# Local Apple/Expo credentials must never enter a cloud source archive.
credentials.json
*.p8
*.p12
*.mobileprovision
*.pem
*.key

# Native module build outputs and local tooling state are not cloud build sources.
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.gradle/
apps/mobile/modules/*/android/.cxx/
__pycache__/
.claude/

# Cloud build source only. Retain the monorepo lockfile/workspace manifests.
/docs/
/data/
/.work/
/.agents/
/.codex/
/apps/service/**
!/apps/service/package.json
/ops/**
!/ops/apply-decoder-patch.cjs
!/ops/check-scan-timing-release.cjs
# Historical detector reference is not a runtime resource.
/apps/mobile/modules/shelf-benchmark/reference/
# Secrets, machine state, generated native projects and artifacts stay local.
*.sqlite
*.sqlite-*
*.db
*.db-*
*.keystore
.npmrc
.DS_Store
.kotlin/
Pods/
DerivedData/
*.log

# Private credentials and operator metadata stay on this server.
/.secrets/
