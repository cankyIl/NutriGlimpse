{
  "expo": {
    "name": "NutriGlimpse",
    "slug": "grocery-app-preview",
    "scheme": "grocery-preview",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.cac.healthgrocery.beta0",
      "buildNumber": "25",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "org.cac.healthgrocery.beta0",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "icon": "./assets/icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "Use the camera for grocery scanning and optional lipid report photos. Original report photos stay on this phone and temporary copies are removed."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "microphonePermission": false,
          "cameraPermission": "Use the camera for grocery scanning and optional lipid report photos. Original report photos stay on this phone and temporary copies are removed."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow location while using the app to identify your likely grocery store and find nearby alternatives. Store searches share the selected store or approximate location with our search provider.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "./plugins/withPrivateStorage",
      "./plugins/withSceneLifecycle"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bef5554a-3cae-4c5e-92ff-5510a7600685"
      }
    },
    "owner": "buldygaur",
    "description": "Know your food. Understand your choices."
  }
}
