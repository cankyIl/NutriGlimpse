# Documentation/example only: the service does not automatically load dotenv files.
# Optional public provider contact; otherwise the existing private OFF config is used.
GROCERY_PROVIDER_CONTACT=maintainer@example.invalid
# API credentials are NOT read from EXPO_PUBLIC_* variables or bundled into the phone.
# Use the interactive setup helpers listed in docs/SELF-HOSTING.md.
# Backend access protection is deferred for the current beta. Do not expose a fork's
# paid endpoints until its operator has chosen appropriate access/spend controls.
